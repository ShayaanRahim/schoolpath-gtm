# the single switch: shadow (default) writes shadow/shadow_log.csv; live writes to the ops sheet + redirect table
MODE=shadow

# llm. with a key, scoring + drafting run automatically. without one, LLM_BACKEND=file writes prompts to
# shadow/pending_prompts/ for pasting into any chat model.
ANTHROPIC_API_KEY=
LLM_BACKEND=

# reddit public json needs only a descriptive user agent
REDDIT_USER_AGENT=schoolpath-community/0.1 (ops@schoolpath.co)

# optional: google programmable search (free tier) for the bump / indexed nextdoor posts
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# live mode ops sheet (tabs: Queue, Capture, Accounts, Results)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# clean short links via the /r/<code> route on schoolpath.co (docs/offshore-dev-spec.md).
# keep set in shadow mode (it's what the shadow log shows). in live mode, blank it until the route ships -> full utm links.
SHORTLINK_BASE=https://schoolpath.co/r
